# 먼저 scripts/build-poc.sh로 잠긴 실모델 이미지를 준비한다.
FROM evidrug-admet-smoke:1.4.0 AS admet
FROM evidrug-deeppurpose-dta-smoke:0.1.5-bindingdb-dual AS dta
FROM evidrug-ctoxpred2-smoke:0.1.0-rf-ssl AS ctox
FROM ghcr.io/astral-sh/uv:0.11.24 AS uv
FROM python:3.12.13-slim-bookworm

ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy MPLCONFIGDIR=/tmp/matplotlib
COPY --from=uv /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends \
    libexpat1 libgomp1 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*
# Python 3.10 모델 환경과 Python 3.12 API 환경을 섞지 않는다.
COPY --from=dta /usr/local/bin/python3.10 /usr/local/bin/python3.10
COPY --from=dta /usr/local/lib/python3.10 /usr/local/lib/python3.10
COPY --from=dta /usr/local/lib/libpython3.10.so.1.0 /usr/local/lib/libpython3.10.so.1.0
COPY --from=ctox /usr/local/bin/python3.9 /usr/local/bin/python3.9
COPY --from=ctox /usr/local/lib/python3.9 /usr/local/lib/python3.9
COPY --from=ctox /usr/local/lib/libpython3.9.so.1.0 /usr/local/lib/libpython3.9.so.1.0
RUN ldconfig
COPY --from=dta /app /opt/dta
COPY --from=dta /opt/deeppurpose /opt/deeppurpose
COPY --from=admet /app /opt/admet
COPY --from=ctox /opt/ctoxpred2 /opt/ctoxpred2
# Binary distributions keep the upstream model-runtime notices alongside the artifacts.
COPY --from=admet /licenses /licenses/admet-ai
COPY --from=dta /licenses /licenses/deeppurpose
# uv venv의 interpreter link를 최종 이미지의 대응 Python에 명시적으로 연결한다.
RUN ln -sf /usr/local/bin/python3.10 /opt/dta/.venv/bin/python \
    && ln -sf /usr/local/bin/python3.12 /opt/admet/.venv/bin/python \
    && ln -sf /usr/local/bin/python3.9 /opt/ctoxpred2/.venv/bin/python
# 모델 추론/LLM 없이 이전한 환경의 import와 자산 경로를 빌드 시 확인한다.
RUN cd /opt/admet && .venv/bin/python -c "import admet_ai; from runtime import ASSET_MANIFEST; assert ASSET_MANIFEST.is_file()"
RUN cd /opt/dta && .venv/bin/python -c "from DeepPurpose import DTI; from smoke import MODEL_DIR, MPNN_MODEL_DIR; assert all((path / 'model.pt').is_file() for path in (MODEL_DIR, MPNN_MODEL_DIR))"
RUN /opt/ctoxpred2/.venv/bin/python /opt/ctoxpred2/runtime.py \
    --artifact-root /opt/ctoxpred2/artifacts --verify-only
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/src ./src
RUN uv sync --frozen --no-dev
RUN groupadd --system evidrug && useradd --system --gid evidrug --home-dir /tmp evidrug
# DeepPurpose checkpoint의 상대 result_folder(./result)는 worker cwd=/app 기준이다.
# /opt/dta로 옮긴 smoke 이미지의 /app/result는 이 경로를 준비하지 못한다.
# 코드·모델 전체가 아니라 결과 디렉터리에만 runtime 사용자 쓰기 권한을 준다.
RUN install -d -m 0750 -o evidrug -g evidrug /app/result
USER evidrug
# 실제 실행 사용자/cwd에서 확인한다. 모델 추론·LLM·DB 없이 권한 회귀를 잡는다.
RUN /app/.venv/bin/python -c "from pathlib import Path; from tempfile import TemporaryFile; assert Path.cwd() == Path('/app'); f = TemporaryFile(dir='result'); f.close()"
CMD ["celery", "-A", "evidrug_api.worker:celery_app", "worker", "--loglevel=INFO", "--concurrency=1"]
