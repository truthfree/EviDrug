EVIDRUG_AUTH_ATTEMPT_LIMIT=5
EVIDRUG_AUTH_ATTEMPT_WINDOW_SECONDS=300
# 아래 호출 한도는 IP별이 아닌 단일 프로세스 전체 공유 값이다.
EVIDRUG_API_RATE_WINDOW_SECONDS=60
EVIDRUG_API_TOTAL_LIMIT=120
EVIDRUG_API_LOGIN_LIMIT=20
EVIDRUG_API_SEARCH_LIMIT=30
EVIDRUG_API_VALIDATION_LIMIT=10
EVIDRUG_API_ANALYSIS_LIMIT=5
EVIDRUG_API_MAX_CONCURRENT_REQUESTS=4
EVIDRUG_API_MAX_BODY_BYTES=32768
EVIDRUG_API_BODY_TIMEOUT_SECONDS=10
EVIDRUG_ORCHESTRATION_LEASE_SECONDS=1200
EVIDRUG_OPENAI_API_KEY=
EVIDRUG_OPENAI_BASE_URL=https://dacon-apim-hackathon-0903.azure-api.net/hackathon/openai/v1
EVIDRUG_OPENAI_MODEL=gpt-5.6-sol
EVIDRUG_OPENAI_TIMEOUT_SECONDS=60
EVIDRUG_OPENAI_MAX_RETRIES=2
EVIDRUG_OPEN_TARGETS_GRAPHQL_URL=https://api.platform.opentargets.org/api/v4/graphql
EVIDRUG_OPEN_TARGETS_TIMEOUT_SECONDS=15
EVIDRUG_DISEASE_CANDIDATE_LIMIT=5
EVIDRUG_UNIPROT_BASE_URL=https://rest.uniprot.org
EVIDRUG_TARGET_LOOKUP_TIMEOUT_SECONDS=20
EVIDRUG_TARGET_CANDIDATE_LIMIT=5
EVIDRUG_TARGET_SHORTLIST_LIMIT=3
EVIDRUG_POC_MODELS_ENABLED=false
EVIDRUG_CTOXPRED2_RECALL_ENABLED=false
